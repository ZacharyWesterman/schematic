// tick_node{0,0} = ticker(
//     "My Ticker"
//     // No input values for ticker, however!
//     // all nodes may take a single string for their title.
// ) -> (
//     // Output default values (only allowed for "none" outputs)
//     tick = string[],
// )

// count_node{5,5} = count(
//     // This is the value that *this node* has for its field(s), which may differ from the default values.
//     value = 1
// )

// log_node{4,3} = logger(
//     info = "custom value"
//     // No custom value for 'warn' field is OK; it will get the default value.
// )

"Comment Name"{4,4} = "Comment contents"

// tick_node.tick ->
//     | {1,2} -> count_node.count
//     | {1,2} -> log_node.info
//     | {1,2} -> log_node.trigger

// vector := `{` value `,` value `}`
// arg := ident `=` value
/*
value :=
    | <number>
    | <string>
    | ident
    | `[` (<number> | <string>)* `]`
*/

