[@time]
node ticker as "Ticker" {
    out init: none as "Init"

    //"none" outputs can be given a value.
    out tick: none as "Tick"
    out total: number as "Count"

    `
    local tick_count: number = 0
    `

    on !init `
        tick_count = 0
        output_init()
    `

    on !tick `
        tick_count = tick_count + 1
        output_tick()
        output_total(tick_count)
    `
}
